# VOD Manager — configuração. Copie para .env e ajuste.
# Toda variável tem o prefixo VODM_. Configuração inválida derruba o processo no boot,
# listando TODOS os problemas de uma vez.

# --- Obrigatórias ---------------------------------------------------------

# Conexão com o Postgres.
VODM_DATABASE_URL=postgres://vodm:vodm@localhost:5432/vodm?sslmode=disable

# Chave mestra AES-256 em base64, usada para cifrar as credenciais das fontes.
# Gere com:  go run ./cmd/vodmanager genkey
# Guarde FORA do repositório. Perder esta chave torna as credenciais irrecuperáveis.
VODM_ENCRYPTION_KEY=

# --- Identidade e papel ---------------------------------------------------

# manager = plano de controle | node = plano de dados | all = tudo no mesmo processo
VODM_ROLE=all
VODM_NODE_ID=node-1

# --- HTTP -----------------------------------------------------------------

VODM_HTTP_ADDR=:8080
VODM_SHUTDOWN_TIMEOUT=20s

# Só habilite com um proxy reverso confiável à frente: sem ele, X-Forwarded-For é
# forjável e o rate limit por IP deixa de valer.
VODM_TRUST_PROXY=false

# --- Banco ----------------------------------------------------------------

VODM_DB_MAX_CONNS=10
VODM_DB_CONNECT_TIMEOUT=10s

# --- Sessão e login -------------------------------------------------------

VODM_SESSION_TTL=12h
VODM_COOKIE_NAME=vodm_session
# Deixe true em produção com HTTPS.
VODM_COOKIE_SECURE=false
VODM_LOGIN_MAX_ATTEMPTS=5
VODM_LOGIN_WINDOW=15m

# --- Primeiro administrador ----------------------------------------------

# Só tem efeito quando o banco não tem nenhum usuário. Se a senha ficar vazia, o
# sistema gera uma e a exibe UMA vez no log de partida.
VODM_BOOTSTRAP_ADMIN_USERNAME=admin
VODM_BOOTSTRAP_ADMIN_PASSWORD=

# --- Observabilidade ------------------------------------------------------

VODM_LOG_LEVEL=info
VODM_LOG_FORMAT=json
VODM_METRICS_ENABLED=true

# --- Testes ---------------------------------------------------------------

# Se definida, os testes de integração usam este Postgres em vez de baixar um embutido.
# VODM_TEST_DATABASE_URL=postgres://vodm:vodm@localhost:5432/vodm_test?sslmode=disable

# Detecção do vídeo de manutenção.
#
# Fonte em manutenção não devolve erro: devolve HTTP 200 com um aviso de dez segundos no
# lugar do filme. Para o proxy isso é sucesso, e o failover nunca seria acionado — o
# espectador veria o aviso e a segunda fonte, que tem o conteúdo, ficaria sem ser tentada.
#
# Abaixo deste tamanho a resposta é tratada como aviso e a próxima origem é tentada. A
# ÚLTIMA origem é sempre servida, mesmo suspeita: dez segundos de aviso são ruins, nada é
# pior.
#
# Padrão 100 MB. Use -1 para desligar a detecção.
#
# Subir pega avisos gravados em alta definição, que passam dos 20 MB. Descer protege
# episódio curto e muito comprimido. Errar para mais custa alguns segundos até o primeiro
# byte, porque a próxima origem é tentada; errar para menos custa o espectador vendo dez
# segundos de aviso e achando que o filme acabou.
# VODM_VIDEO_MINIMO_MB=100

# ---------------------------------------------------------------------------
# Armazenamento de mídia (cache de fontes e acervo próprio)
# ---------------------------------------------------------------------------
# Onde os arquivos de vídeo guardados por esta instalação ficam.
#
# É propriedade da MÁQUINA, não da operação: numa migração para outro servidor este valor
# não viaja junto com os dados, porque o disco de lá é outro. O que é decisão de operação
# — ligar o cache, o destino padrão, o limite — fica nas Configurações do painel.
#
# A pasta precisa estar no ReadWritePaths da unidade do systemd; o instalador cuida disso.
# VODM_ARMAZENAMENTO_LOCAL=/opt/vodmanager/acervo

# Espaço, em GB, que o cache nunca ocupa.
#
# Um disco 100% cheio não deixa o Postgres escrever, e o sintoma disso não é "o cache
# encheu" — é o sistema inteiro parando.
# VODM_ARMAZENAMENTO_RESERVA_GB=5
